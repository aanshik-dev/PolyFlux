# PolyFlux Backend Environment Variables

# Server port (automatically assigned on Render, default 8081)
PORT=8081
SERVER_PORT=8081

# Cloud PostgreSQL Configuration (e.g. Render / Neon / Supabase)
# Option A: Full JDBC connection string
DATABASE_URL=jdbc:postgresql://localhost:5432/polyflux

# Option B: Individual connection components
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=polyflux
DATABASE_USER=polyflux
DATABASE_PASSWORD=change-me-for-shared-environments

# Allowed Frontend Origins for CORS (comma-separated, include your Vercel deployment URL)
ULPF_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,https://your-frontend.vercel.app
