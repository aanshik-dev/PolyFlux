# ==============================================================================
# PolyFlux Local & Production Environment Reference
# ==============================================================================

# PostgreSQL Database (Cloud DB on Render/Neon or Local)
POSTGRES_DB=polyflux
POSTGRES_USER=polyflux
POSTGRES_PASSWORD=change-me-for-shared-environments

# Backend Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/polyflux
ULPF_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,https://your-frontend.vercel.app

# Frontend Configuration
VITE_API_BASE_URL=https://your-backend.onrender.com/api/v1
